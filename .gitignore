# ─────────────────────────────────────────────
# Entornos virtuales / Python
# ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
src/__pycache__/
run/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Streamlit cache local
.streamlit/

# ─────────────────────────────────────────────
# Datos reales IEO y artefactos derivados
# ─────────────────────────────────────────────
data/raw/*
data/interim/*
data/processed/*
data/quarantine/*
data/pending_review/*
!data/**/.gitkeep

# ─────────────────────────────────────────────
# Outputs generados (dependen de datos reales)
# ─────────────────────────────────────────────
outputs/figures/*
outputs/reports/*
!outputs/**/.gitkeep

# ─────────────────────────────────────────────
# Documentación/archivos locales grandes o temporales
# ─────────────────────────────────────────────
docs/PEC/
docs/PEC/**/~WRL*.tmp
informe_auditoria_ICES_files/
docs/recon_global.md
informe_auditoria_ICES.html
informe_auditoria_ICES.qmd
informe_auditoria_ICES_files/

# Auditoría externa (proyecto independiente)
auditoria_advicExplorer/

# ─────────────────────────────────────────────
# Editores y SO
# ─────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ─────────────────────────────────────────────
# Tests y CI local
# ─────────────────────────────────────────────
.pytest_tmp/
.pytest_cache/
*.cover
htmlcov/

# ─────────────────────────────────────────────
# Cursor IDE (local, no compartir)
# ─────────────────────────────────────────────
.cursor/

