# ─────────────────────────────────────────────
# Entornos virtuales / Python
# ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
src/__pycache__/
run/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Streamlit cache local
.streamlit/

# ─────────────────────────────────────────────
# Datos reales IEO y artefactos derivados
# ─────────────────────────────────────────────
data/cnv/*
data/checked/*
data/csv/*
data/quarantine/*
!data/cnv/.gitkeep
!data/quarantine/.gitkeep

# Toy dataset sintético — SÍ se versiona (datos ficticios, sin embargo IEO)
!data/demo_cnv/
!data/demo_cnv/**

# ─────────────────────────────────────────────
# Outputs generados (dependen de datos reales)
# ─────────────────────────────────────────────
outputs/figures/*
outputs/reports/*
outputs/runs/*
outputs/artifact_cache/*
outputs/pipeline_manifest.json
outputs/temporal/*
outputs/audit/*
outputs/cnv_exploratory_scatter/*
outputs/RESUMEN_ULTIMA.html
outputs/LEEME_RESUMEN.txt
outputs/audit_report.md
outputs/audit_report_gijon_bars.png
!outputs/temporal/.gitkeep

# ─────────────────────────────────────────────
# Documentación/archivos locales grandes o temporales
# ─────────────────────────────────────────────
docs/PEC/
docs/PEC/**/~WRL*.tmp
informe_auditoria_ICES_files/
docs/recon_global.md
informe_auditoria_ICES.html
informe_auditoria_ICES.qmd
informe_auditoria_ICES_files/

# Auditoría externa (proyecto independiente)
auditoria_advicExplorer/

# ─────────────────────────────────────────────
# Editores y SO
# ─────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

